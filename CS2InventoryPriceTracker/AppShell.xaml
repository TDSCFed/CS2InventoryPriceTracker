<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:CS2InventoryPriceTracker.Views"
       x:Class="CS2InventoryPriceTracker.AppShell"
       FlyoutBehavior="Disabled"
       Shell.TabBarForegroundColor="{StaticResource Primary}"
       Shell.TabBarUnselectedColor="#9A9AA5">

    <TabBar>
        <ShellContent Title="Inventory" Icon="tab_inventory.png" Route="inventory" ContentTemplate="{DataTemplate views:InventoryPage}" />
        <ShellContent Title="Account" Icon="tab_settings.png" Route="account" ContentTemplate="{DataTemplate views:SettingsPage}" />
    </TabBar>

</Shell>
