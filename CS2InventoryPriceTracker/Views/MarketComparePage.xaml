<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CS2InventoryPriceTracker.ViewModels"
             x:Class="CS2InventoryPriceTracker.Views.MarketComparePage"
             Title="Compare markets">

    <Grid RowDefinitions="Auto,Auto,*" Padding="12,8" RowSpacing="6">

        <VerticalStackLayout Spacing="0">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Picker Title="Sort by"
                        ItemsSource="{Binding SortChoices}"
                        ItemDisplayBinding="{Binding Label}"
                        SelectedItem="{Binding SelectedSort}" />
                <Picker Grid.Column="1" Title="Price"
                        ItemsSource="{Binding MinPriceChoices}"
                        ItemDisplayBinding="{Binding Label}"
                        SelectedItem="{Binding SelectedMinPrice}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Steam after its 15% fee (what you receive)" FontSize="13" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding SteamAfterFee}" OnColor="{StaticResource Primary}" />
            </Grid>
        </VerticalStackLayout>

        <Label Grid.Row="1" Text="{Binding SummaryText}" FontSize="12" Opacity="0.7" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Rows}" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <Label Text="No differences yet. Prices from at least two markets are needed: open the Inventory tab and let prices load."
                       HorizontalTextAlignment="Center" Margin="24" Opacity="0.7" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MarketCompareViewModel}}, Path=OpenCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="4,64,*,Auto" ColumnSpacing="10">
                            <BoxView Color="{Binding RarityColor}" CornerRadius="2" />
                            <Image Grid.Column="1" Source="{Binding IconUrl}" WidthRequest="64" HeightRequest="48" Aspect="AspectFit" />
                            <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" LineBreakMode="TailTruncation" MaxLines="2" />
                                <Label Text="{Binding HighText}" FontSize="12" TextColor="{StaticResource PriceGreen}" />
                                <Label Text="{Binding CheapText}" FontSize="12" Opacity="0.7" />
                                <Label Text="{Binding QuantityText}" IsVisible="{Binding HasQuantity}" FontSize="11" Opacity="0.6" />
                            </VerticalStackLayout>
                            <Label Grid.Column="3" Text="{Binding GapText}" FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource PriceGreen}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
