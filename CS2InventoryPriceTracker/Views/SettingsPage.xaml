<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CS2InventoryPriceTracker.Views.SettingsPage"
             Title="Account">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- Current account -->
            <Border Style="{StaticResource Card}" Padding="12" IsVisible="{Binding HasAccount}">
                <Grid ColumnDefinitions="56,*" ColumnSpacing="12">
                    <Image Source="{Binding AvatarUrl}" WidthRequest="56" HeightRequest="56" Aspect="AspectFill" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="{Binding PersonaName}" FontSize="17" FontAttributes="Bold" />
                        <Label Text="{Binding SteamId}" FontSize="12" Opacity="0.7" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Label Text="Steam account" FontSize="17" FontAttributes="Bold" />
            <Label Text="Paste your Steam profile link (steamcommunity.com/id/... or /profiles/...), your SteamID64 or your custom URL name."
                   FontSize="13" Opacity="0.7" />
            <Entry Text="{Binding ProfileInput}" Placeholder="https://steamcommunity.com/id/yourname"
                   Keyboard="Url" ReturnCommand="{Binding SaveCommand}" ClearButtonVisibility="WhileEditing" />
            <Button Text="Save account" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" />
            <Label Text="{Binding Message}" FontSize="13" />

            <BoxView HeightRequest="1" Opacity="0.15" Color="Gray" Margin="0,8" />

            <!-- Steam login (storage units) -->
            <Label Text="Storage units" FontSize="17" FontAttributes="Bold" />
            <Label FontSize="13" Opacity="0.7"
                   Text="Steam doesn't show what is inside storage units publicly. Log in to Steam to read them from CS2. Your password is only sent to Steam and never stored; the app keeps a Steam login token in the phone's secure storage. Loading storage units briefly shows you as playing CS2, so close CS2 on your PC first." />

            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsLoggedIn}">
                <Label Text="{Binding LoggedInText}" FontSize="15" FontAttributes="Bold" />
                <Button Text="Log out of Steam" Command="{Binding LogoutCommand}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsLoggedOut}">
                <Entry Text="{Binding LoginAccountName}" Placeholder="Steam account name"
                       Keyboard="Plain" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                <Entry Text="{Binding LoginPassword}" Placeholder="Password" IsPassword="True"
                       ReturnCommand="{Binding LoginCommand}" />
                <Button Text="Log in to Steam" Style="{StaticResource PrimaryButton}" Command="{Binding LoginCommand}" />
            </VerticalStackLayout>
            <Label Text="{Binding LoginMessage}" FontSize="13" />
            <Button Text="Copy Steam log" IsVisible="{Binding CanCopyLog}" Command="{Binding CopyLogCommand}" />

            <BoxView HeightRequest="1" Opacity="0.15" Color="Gray" Margin="0,8" />

            <Label Text="Prices" FontSize="17" FontAttributes="Bold" />
            <Picker Title="Price used for values and totals"
                    ItemsSource="{Binding PriceSourceChoices}"
                    ItemDisplayBinding="{Binding Label}"
                    SelectedItem="{Binding SelectedPriceSource}" />
            <Label FontSize="13" Opacity="0.7"
                   Text="Every item shows its price on each market, in euros: the cheapest current listing (or the median sale price when nothing is listed). Skinport and Market.CSGO send all prices at once and refresh every 30 minutes. The Steam Market allows only about 20 price requests per minute, so its first load of a big inventory takes a while: the most valuable items (by the other markets' prices) get their Steam price first. Steam prices are refreshed after 12 hours, or after 7 days for items worth less than 0,10 € elsewhere." />
            <Label FontSize="13" Opacity="0.7"
                   Text="The inventory must be public: in Steam, go to Edit Profile > Privacy Settings and set My profile and Inventory to Public." />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
