<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CS2InventoryPriceTracker.ViewModels"
             x:Class="CS2InventoryPriceTracker.Views.InventoryPage"
             Title="Inventory">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Update prices" Order="Secondary" Command="{Binding RefreshPricesCommand}" />
    </ContentPage.ToolbarItems>

    <Grid>

        <!-- No account yet -->
        <VerticalStackLayout IsVisible="{Binding NeedsAccount}" Padding="32" Spacing="16" VerticalOptions="Center">
            <Label Text="See your CS2 inventory and what it is worth"
                   FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" />
            <Label Text="Add your Steam account first. Your Steam inventory must be public."
                   HorizontalTextAlignment="Center" Opacity="0.7" />
            <Button Text="Add Steam account" Style="{StaticResource PrimaryButton}" Command="{Binding GoToAccountCommand}" />
        </VerticalStackLayout>

        <Grid IsVisible="{Binding HasAccount}" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Padding="12,8" RowSpacing="6">

            <!-- Total value -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding AccountName}" FontSize="13" Opacity="0.7" />
                        <Label Text="{Binding TotalValueText}" FontSize="28" FontAttributes="Bold"
                               TextColor="{StaticResource PriceGreen}" />
                        <Label Text="{Binding SummaryText}" FontSize="12" Opacity="0.7" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Price progress / last update -->
            <Label Grid.Row="1" Text="{Binding StatusText}" FontSize="12" Opacity="0.7" />

            <!-- Storage unit loading -->
            <HorizontalStackLayout Grid.Row="2" Spacing="8" IsVisible="{Binding IsLoadingStorage}">
                <ActivityIndicator IsRunning="{Binding IsLoadingStorage}" Color="{StaticResource Primary}"
                                   WidthRequest="16" HeightRequest="16" />
                <Label Text="{Binding StorageStatusText}" FontSize="12" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Errors -->
            <Label Grid.Row="3" Text="{Binding ErrorText}" FontSize="13" TextColor="#E5484D">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding ErrorText}" Value="{x:Null}">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <!-- Search, location and sort -->
            <Grid Grid.Row="4" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <SearchBar Grid.ColumnSpan="2" Placeholder="Search items..." Text="{Binding SearchText}" />
                <Picker Grid.Row="1" Grid.ColumnSpan="2" Title="Location"
                        ItemsSource="{Binding LocationChoices}"
                        ItemDisplayBinding="{Binding Label}"
                        SelectedItem="{Binding SelectedLocation}" />
                <Picker Grid.Row="2" Title="Sort by"
                        ItemsSource="{Binding SortChoices}"
                        ItemDisplayBinding="{Binding Label}"
                        SelectedItem="{Binding SelectedSort}" />
                <HorizontalStackLayout Grid.Row="2" Grid.Column="1" Spacing="4" VerticalOptions="Center">
                    <Label Text="Unmarketable" FontSize="12" VerticalOptions="Center" Opacity="0.7" />
                    <Switch IsToggled="{Binding ShowUnmarketable}" OnColor="{StaticResource Primary}" />
                </HorizontalStackLayout>
            </Grid>

            <RefreshView Grid.Row="5"
                         IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}"
                         RefreshColor="{StaticResource Primary}">
                <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <Label Text="No items. Pull down to load your inventory from Steam, or adjust your search."
                               HorizontalTextAlignment="Center"
                               Margin="24"
                               Opacity="0.7" />
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventoryViewModel}}, Path=OpenItemCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="4,72,*,Auto" ColumnSpacing="10">
                                    <!-- Rarity -->
                                    <BoxView Color="{Binding RarityColor}" CornerRadius="2" />
                                    <Image Grid.Column="1" Source="{Binding IconUrl}"
                                           WidthRequest="72" HeightRequest="54" Aspect="AspectFit" />
                                    <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold"
                                               LineBreakMode="TailTruncation" MaxLines="2" />
                                        <Label Text="{Binding Subtitle}" FontSize="12" Opacity="0.7"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding MarketPricesText}" IsVisible="{Binding HasMarketPrices}"
                                               FontSize="11" Opacity="0.6" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="3" Spacing="2" VerticalOptions="Center"
                                                         HorizontalOptions="End">
                                        <Label Text="{Binding PriceText}" FontSize="14" FontAttributes="Bold"
                                               HorizontalTextAlignment="End" />
                                        <Label Text="{Binding QuantityText}" IsVisible="{Binding HasQuantity}"
                                               FontSize="12" Opacity="0.7" HorizontalTextAlignment="End" />
                                        <Label Text="{Binding TotalText}" IsVisible="{Binding HasTotal}"
                                               FontSize="12" TextColor="{StaticResource PriceGreen}"
                                               HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>
    </Grid>
</ContentPage>
