<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>CS2InventoryPriceTracker</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name and app identity -->
		<ApplicationTitle>CS2 Inventory</ApplicationTitle>
		<ApplicationId>com.tiago.cs2inventorypricetracker</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App icon and splash screen -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1A1D26" />
		<!-- Tab bar icons (24x24, tinted by the tab bar) -->
		<MauiImage Include="Resources\Images\*.svg" BaseSize="24,24" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1A1D26" BaseSize="128,128" />
		<!-- Item names for storage unit contents (generated by tools/generate_item_data.py) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- MAUI itself, at the version of the installed MAUI workload (as in the .NET MAUI template) -->
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.10" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<!-- Steam login and the CS2 Game Coordinator (storage unit contents) -->
		<PackageReference Include="SteamKit2" Version="3.5.0" />
	</ItemGroup>

</Project>
