<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Unit tests for the app's logic. The app itself targets Android only, so instead of referencing it this project
		compiles the platform-independent source files directly (linked below). TESTS turns off the few MAUI-only parts.
	-->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<DefineConstants>$(DefineConstants);TESTS</DefineConstants>
		<RootNamespace>CS2InventoryPriceTracker.Tests</RootNamespace>
		<!-- SQLitePCLRaw ships Alpine-specific native files that .NET no longer looks up; harmless here -->
		<NoWarn>$(NoWarn);NETSDK1206</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
		<!-- Shows failed tests as annotations on the GitHub Actions run -->
		<PackageReference Include="GitHubActionsTestLogger" Version="2.4.1" />
		<!-- Same versions as the app -->
		<PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
		<PackageReference Include="SteamKit2" Version="3.5.0" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\..\CS2InventoryPriceTracker\Models\InventoryModels.cs" Link="App\Models\InventoryModels.cs" />
		<Compile Include="..\..\CS2InventoryPriceTracker\Services\PriceSources.cs" Link="App\Services\PriceSources.cs" />
		<Compile Include="..\..\CS2InventoryPriceTracker\Services\IPriceProvider.cs" Link="App\Services\IPriceProvider.cs" />
		<Compile Include="..\..\CS2InventoryPriceTracker\Services\SteamMarketPriceProvider.cs" Link="App\Services\SteamMarketPriceProvider.cs" />
		<Compile Include="..\..\CS2InventoryPriceTracker\Services\BulkPriceProvider.cs" Link="App\Services\BulkPriceProvider.cs" />
		<Compile Include="..\..\CS2InventoryPriceTracker\Services\ItemCatalog.cs" Link="App\Services\ItemCatalog.cs" />
		<Compile Include="..\..\CS2InventoryPriceTracker\Services\ItemCategories.cs" Link="App\Services\ItemCategories.cs" />
		<Compile Include="..\..\CS2InventoryPriceTracker\Services\SteamInventoryService.cs" Link="App\Services\SteamInventoryService.cs" />
		<Compile Include="..\..\CS2InventoryPriceTracker\Services\GcItemParser.cs" Link="App\Services\GcItemParser.cs" />
	</ItemGroup>

	<ItemGroup>
		<!-- The item table shipped in the APK (CI regenerates it before the tests run) -->
		<None Include="..\..\CS2InventoryPriceTracker\Resources\Raw\items.json" Link="items.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
